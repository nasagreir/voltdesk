# Home Assistant — same pattern as OrbitDesk
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
# Entity prefix for sensor.<prefix>_battery, e.g. model_y
TESLA_ENTITY_PREFIX=

# Tesla Fleet API (read-only telemetry). Leave blank to stay in demo mode.
TESLA_CLIENT_ID=
TESLA_REFRESH_TOKEN=
# na | eu | cn
TESLA_REGION=na

# auto | tesla | home-assistant | demo
VOLTDESK_SOURCE=auto
POLL_INTERVAL_SECONDS=60
ELECTRICITY_RATE_USD=0.14
DISTANCE_UNIT=mi
TEMP_UNIT=F

# Optional home geofence
HOME_LABEL=Home
# HOME_LAT=
# HOME_LNG=
# HOME_RADIUS_M=200

# Optional work geofence. WORK_RATE_USD=0 tags those charges as free.
WORK_LABEL=Work
# WORK_LAT=
# WORK_LNG=
# WORK_RADIUS_M=200
# WORK_RATE_USD=0

# Auth (required in production — min 16 chars). The LXC installer generates this.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional read-only token for a Grok bot (Authorization: Bearer).
# You can also generate one on Connections. Either value is accepted.
# VOLTDESK_API_TOKEN=

# Optional xAI key so the garage can ask Grok for a few suggestions.
# You can also save one on Settings → Grok bot. The key stays on the server.
# XAI_API_KEY=
# GROK_API_KEY=
# GROK_MODEL=grok-4.7

# Optional Paperless-ngx host for service invoices.
# Uploads get PAPERLESS_TAG and a per-visit tag vd-visit-<id>.
# PAPERLESS_URL=http://paperless.local:8000
# PAPERLESS_TOKEN=
# PAPERLESS_TAG=VoltDesk
# VOLTDESK_DATA_DIR=/opt/voltdesk/data

# FORCE_DEMO_MODE=true
